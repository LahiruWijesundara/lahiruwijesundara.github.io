<div class="list-groups">
  {% assign certificates = data[1] | sort: 'date' | reverse %}
  <div class="row">
    {% for content in certificates %}
      {% assign itemCount = content.items | size %}
      <div class="col-12 mb-3">
        <table class="table-cv list-group-table w-100">
          <tbody>
            <!-- First row: icon, course name, date -->
            <tr>
              <!-- icon cell -->
              <td class="list-group-category-icon">
                {% if content.icon %}
                  <i class="{{ content.icon }}"></i>
                {% endif %}
              </td>
              <!-- course name spans itemCount columns -->
              <td colspan="{{ itemCount }}" class="list-group-category">
                <a href="{{ content.url | default: '#' }}">{{ content.name }}</a>
              </td>
              <!-- date cell, right-aligned -->
              <td class="list-group-date text-right">
                {{ content.date }}
              </td>
            </tr>

            <!-- Second row: issuer spanning icon + name columns -->
            <tr>
              <td></td>
              <td colspan="{{ itemCount+1 }}" class="list-group-name">
                <b>{{ content.issuer }}</b>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    {% endfor %}
  </div>
</div>
